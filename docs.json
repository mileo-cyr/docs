{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Cyrisma Documentation",
  "colors": {
    "primary": "#5941E0",
    "light": "#7B68EE",
    "dark": "#4530B8"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Legacy Partner API",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/getting-started",
              "api-reference/authentication"
            ]
          }
        ],
        "openapi": "openapi.json"
      },
      {
        "tab": "New Partner API",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "new-partner-api/introduction",
              "new-partner-api/authentication",
              "new-partner-api/conventions"
            ]
          },
          {
            "group": "Provisioning",
            "openapi": "new-partner-api/provisioning.json"
          },
          {
            "group": "Reporting",
            "openapi": "new-partner-api/reporting.json"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/cyrisma.png",
    "dark": "/logo/cyrisma.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://portal.cyrisma.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/cyrisma/"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/api-reference/getting-started"
    },
    {
      "source": "/index",
      "destination": "/api-reference/getting-started"
    }
  ],
  "api": {
    "playground": {
      "display": "simple"
    },
    "mdx": {
      "server": "https://ccnnnnnn.cyrisma.com/app"
    }
  }
}
